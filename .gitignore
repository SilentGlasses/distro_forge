.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.swo

# Node (not used, but tooling may create these)
node_modules/
npm-debug.log

# Logs
*.log

# Local Python virtualenvs
.venv/

# Always track source directories, even if a contributor's global gitignore
# excludes common names like "lib" or "scripts" (this file takes precedence).
!/scripts/
!/assets/lib/

# Workflow artifacts generated by scripts/* and consumed via body-path
.release-notes.md
.third-party-report.txt
.third-party-report.json
